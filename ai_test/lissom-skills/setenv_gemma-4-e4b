#!/bin/bash
# This script configures environment variables for Claude Code to route through LiteLLM proxy.
# Usage: source this file (e.g., `. ./setenv`) before running Claude Code.
# It sets LITELLM_API_KEY, LITELLM_API_BASE, etc.

export ANTHROPIC_API_KEY="" # must be explicitly set to empty
export ANTHROPIC_BASE_URL=http://localhost:4000
export ANTHROPIC_AUTH_TOKEN=dummy
export ANTHROPIC_DEFAULT_OPUS_MODEL="google/gemma-4-e4b"
export ANTHROPIC_DEFAULT_SONNET_MODEL="google/gemma-4-e4b"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="google/gemma-4-e4b"
export CLAUDE_CODE_SUBAGENT_MODEL="google/gemma-4-e4b"

export GAME_DIR="gemma-4-e4b"
